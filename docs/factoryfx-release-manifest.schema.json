{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArSonMix FactoryFX Release Manifest v1",
  "description": "SCHEMA ONLY; actual shipped Factory FX manifest is generated after verified licenses, VST3 identities, artifacts and file hashes. Planned entries are not loadable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "hostFormat",
    "distribution",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "platform": {
      "const": "windows-x64"
    },
    "hostFormat": {
      "const": "VST3"
    },
    "distribution": {
      "enum": [
        "engineering-partial",
        "production-six"
      ]
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "displayName",
          "category",
          "pluginVersion",
          "sourceRepo",
          "sourceCommit",
          "artifactSha256",
          "bundleRelativePath",
          "vst3ClassId",
          "licenseReview",
          "entitlementPolicy",
          "notices",
          "files"
        ],
        "properties": {
          "productId": {
            "enum": [
              "arson-eq",
              "arson-comp",
              "arson-verb",
              "arson-harmony",
              "arson-color",
              "arsonkupik-enhancer"
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 2
          },
          "category": {
            "enum": [
              "EQ",
              "COMP",
              "REVERB",
              "HARMONY",
              "COLOR",
              "ENHANCER"
            ]
          },
          "pluginVersion": {
            "type": "string",
            "minLength": 1
          },
          "sourceRepo": {
            "type": "string",
            "pattern": "^masarray/[A-Za-z0-9_.-]+$"
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bundleRelativePath": {
            "type": "string",
            "pattern": "^FactoryFX/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+\\.vst3$"
          },
          "vst3ClassId": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{32}$"
          },
          "licenseReview": {
            "const": "approved"
          },
          "entitlementPolicy": {
            "enum": [
              "unrestricted",
              "separate-license",
              "factory-entitlement"
            ]
          },
          "notices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^FactoryFX/licenses/[A-Za-z0-9_.-]+$"
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
